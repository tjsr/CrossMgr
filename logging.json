{
  "version": 1,
  "disable_existing_loggers": true,
  "formatters": {
    "simple": {
      "format": "%(asctime)s %(name)s [%(levelname)s] %(message)s"
    },
    "method": {
      "format": "%(asctime)s %(name)s:%(funcName)s [%(levelname)s] %(message)s"
    },
    "trace": {
      "format": "%(asctime)s %(name)s@%(filename)s:%(lineno)d:%(funcName)s [%(levelname)s] %(message)s"
    },
    "input": {
      "format": "%(message)s"
    },
    "output": {
      "format": "#%(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "simple",
      "stream": "ext://sys.stdout"
    },
    "file": {
      "class": "logging.FileHandler",
      "formatter": "method",
      "filename": "logs/crossmgr.log"
    },
    "decoderinput": {
      "class": "logging.FileHandler",
      "formatter": "input",
      "filename": "logs/decoder.log"
    },
    "decoderoutput": {
      "class": "logging.FileHandler",
      "formatter": "output",
      "filename": "logs/decoder.log"
    }
  },
  "loggers": {
    "TimingDevice[UltraDecoder].input": {
      "level": "INFO",
      "handlers": ["decoderinput"]
    },
    "TimingDevice[UltraDecoder].output": {
      "level": "INFO",
      "handlers": ["decoderoutput"]
    },
    "root": {
      "class": "CrossMgrLogger",
      "level": "INFO",
      "handlers": ["console", "file"]
    }
  }
}
